# Copy this file to .env and adjust if needed (optional - all values below are already the defaults)

# Database: SQLite by default (zero setup). Switch to Postgres if you want:
# DATABASE_URL=postgresql+psycopg2://mluser:mlpass@localhost:5432/ml_platform
DATABASE_URL=sqlite:///logs/requests.db

# Redis (used for caching + Celery broker)
REDIS_URL=redis://localhost:6379/0

# Set to "true" to offload prediction-logging to a Celery worker instead of
# writing to the DB synchronously. Requires a running Celery worker.
ASYNC_LOGGING=false

# Percentage (0-100) of real traffic sent to the canary/shadow-as-serving model
CANARY_TRAFFIC_PERCENT=0

# Whether the shadow model runs in parallel on every request
SHADOW_ENABLED=true
